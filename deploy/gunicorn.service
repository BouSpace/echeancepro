[Unit]
Description=ÉchéancePro (Gunicorn)
After=network.target postgresql.service

[Service]
User=echeancepro
Group=www-data
WorkingDirectory=/srv/echeancepro/app
ExecStart=/srv/echeancepro/app/.venv/bin/gunicorn config.wsgi:application \
    --workers 3 --bind unix:/run/echeancepro/gunicorn.sock --timeout 60
RuntimeDirectory=echeancepro
RuntimeDirectoryMode=0775
Restart=on-failure
# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
