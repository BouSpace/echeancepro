# À copier sur le serveur dans /srv/echeancepro/app/.env (puis : chmod 600 .env) et à adapter.
# Générer la clé :  python3 -c "import secrets; print(secrets.token_urlsafe(60))"
SECRET_KEY=A_REMPLACER_PAR_UNE_CLE_ALEATOIRE_LONGUE
DEBUG=False
ALLOWED_HOSTS=DOMAINE
CSRF_TRUSTED_ORIGINS=https://DOMAINE
SITE_URL=https://DOMAINE

# Une fois le HTTPS validé, montez progressivement : 3600, puis 31536000
SECURE_HSTS_SECONDS=0

# Fichiers téléversés (photos, pièces jointes) : hors du dossier du code, à sauvegarder
MEDIA_ROOT=/srv/echeancepro/media

# Base PostgreSQL
POSTGRES_DB=echeancepro
POSTGRES_USER=echeancepro
POSTGRES_PASSWORD=A_REMPLACER
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# E-mail (alertes) : serveur SMTP de votre fournisseur
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.exemple.com
EMAIL_PORT=587
EMAIL_HOST_USER=alertes@DOMAINE
EMAIL_HOST_PASSWORD=A_REMPLACER
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ÉchéancePro <alertes@DOMAINE>

SMS_ACTIF=False
