# Copiez ce fichier en .env et adaptez les valeurs.
SECRET_KEY=remplacez-par-une-longue-chaine-aleatoire
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
SITE_URL=http://127.0.0.1:8000

# Paliers d'alerte en jours avant l'échéance (0 = le jour même)
ALERTE_PALIERS=15,7,3,0

# E-mail (en développement, les e-mails s'affichent dans le terminal)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.votre-domaine.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=alertes@votre-domaine.com
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=ÉchéancePro <alertes@votre-domaine.com>

# SMS / WhatsApp pour les cas critiques (désactivé par défaut)
SMS_ACTIF=False
SMS_DESTINATAIRES=+22600000000
SMS_PLAFOND_MENSUEL=200

# PostgreSQL (laisser vide pour utiliser SQLite)
# POSTGRES_DB=echeancepro
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
